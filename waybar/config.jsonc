{
    "layer": "top",
    "position": "top",
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 4,
    "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "battery", "pulseaudio", "tray"], // Ho aggiunto pulseaudio per l'audio

    "niri/workspaces": {
        "format": "{name}"
    },
    "niri/window": {
        "format": "    {title}",
        "max-length": 35
    },
    "clock": {
        "format": "    {:%H:%M  •  %A %d %b}"
    },
    "battery": {
        "format": "    {capacity}%"
    },
    "network": {
        "format-wifi": "    {essid}",
        "format-ethernet": "    Connected",
        "format-disconnected": "    Disconnected",
        "on-click": "nm-connection-editor" // <-- CLICCA QUI PER APRIRE LE RETI
    },
    "pulseaudio": {
        "format": "    {volume}%",
        "format-muted": "    Muted",
        "on-click": "pavucontrol" // <-- CLICCA QUI PER APRIRE IL VOLUME
    }
}

